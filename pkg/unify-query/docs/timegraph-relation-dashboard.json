          "format": "time_series",
          "source": "sum by (query_mode, result) (rate(unify_query_cmdb_relation_route_total{route=\"timegraph\"}[5m]))",
          "type": "range",
          "datasource": {"type": "bkmonitor-timeseries-datasource", "uid": "000000002"}
