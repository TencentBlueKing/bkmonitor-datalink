[
  {"backend": "elasticsearch", "method": "GET", "path": "/golden_es_escaped_keyword"},
  {
    "backend": "elasticsearch",
    "method": "POST",
    "path": "/golden_es_escaped_keyword/_search",
    "body": {
      "_source": {"includes": ["_time", "_value", "message", "cluster", "name"]},
      "from": 0,
      "query": {
        "bool": {
          "filter": [
            {"range": {"dtEventTimeStamp": {"format": "epoch_second", "from": 1784701776, "include_lower": true, "include_upper": true, "to": 1784702076}}},
            {
              "bool": {
                "must": [
                  {"match_phrase": {"message": {"query": "pathname\": \"/srv/app/lib64"}}},
                  {"wildcard": {"cluster": {"value": "region*"}}},
                  {"term": {"name": "bk-log-search-api"}}
                ]
              }
            }
          ]
        }
      },
      "size": 10,
      "sort": [{"dtEventTimeStamp": {"order": "asc", "unmapped_type": "date"}}]
    }
  }
]
